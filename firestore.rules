rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Danh sách email Google được phép dùng trang quản lý. Thêm email đồng nghiệp vào đây rồi Publish.
    function allowed() {
      return request.auth != null && request.auth.token.email in [
        'tiemnhahani@gmail.com'
        // thêm email đồng nghiệp ở đây, cách nhau bằng dấu phẩy, vd: 'ten@gmail.com'
      ];
    }

    // Đơn khách gửi từ cửa hàng web: ai cũng tạo được (không cần đăng nhập) nhưng chỉ đúng dạng và đúng cỡ này.
    function validWebOrder(d) {
      return d.keys().hasOnly(['createdAt', 'message', 'items', 'customer', 'total', 'status', 'source'])
        && d.status == 'new'
        && d.createdAt is number
        && d.total is number && d.total >= 0 && d.total < 1000000000
        && d.message is string && d.message.size() > 0 && d.message.size() <= 6000
        && d.items is list && d.items.size() > 0 && d.items.size() <= 80
        && d.customer is map
        && d.customer.keys().hasOnly(['name', 'phone', 'address', 'account', 'note'])
        && d.customer.name is string && d.customer.name.size() > 0 && d.customer.name.size() <= 120
        && d.customer.phone is string && d.customer.phone.size() <= 20
        && d.customer.address is string && d.customer.address.size() <= 500
        && d.customer.account is string && d.customer.account.size() <= 120
        && d.customer.note is string && d.customer.note.size() <= 600;
    }

    match /shops/{shopId} {
      // Cửa hàng web (website riêng, không đăng nhập) chỉ ĐỌC được sản phẩm và thông tin công khai.
      match /shopProducts/{id} { allow read: if true; }
      match /shopInfo/{id} { allow read: if true; }
      // Đơn từ cửa hàng web: khách chỉ được TẠO; chỉ chủ shop đọc / sửa / xoá được (có tên, SĐT, địa chỉ khách).
      match /shopOrders/{id} { allow create: if validWebOrder(request.resource.data); }
      // Mọi thứ còn lại (kho, đơn, giá vốn…) và việc ghi vào cửa hàng: chỉ email trong danh sách.
      match /{document=**} {
        allow read, write: if allowed();
      }
    }
  }
}
